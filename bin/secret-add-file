#!/bin/bash
# Store a file without routing its contents through the clipboard or disk.
set -euo pipefail
set +x

__self="${BASH_SOURCE[0]}"
while [ -L "$__self" ]; do
  __link="$(readlink "$__self")"
  case "$__link" in
    /*) __self="$__link" ;;
    *) __self="$(cd -P "$(dirname "$__self")" && pwd)/$__link" ;;
  esac
done
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/ui.sh
. "$(cd -P "$(dirname "$__self")/../lib" && pwd)/ui.sh"

usage() {
  echo 'usage: secret-add-file [--base64] [--delete-source] <NAME> <FILE>' >&2
}
fail() { ui_err "secret-add-file: $1"; exit 1; }

encode=0
delete_source=0
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --base64) encode=1; shift ;;
    --delete-source) delete_source=1; shift ;;
    --) shift; break ;;
    -*) usage; exit 64 ;;
    *) break ;;
  esac
done
[ $# -eq 2 ] && [ -n "$1" ] || { usage; exit 64; }
name="$1"
file="$2"
keychain="${SECRET_KEYCHAIN:-ai.keychain}"
[ "$file" != '-' ] && [ -f "$file" ] && [ -r "$file" ] || fail 'FILE must be a readable regular file'
size="$(wc -c < "$file" 2>/dev/null)" || fail 'cannot read FILE'
[ "$size" -gt 0 ] || fail 'FILE is empty'
[ "$size" -le 65536 ] || fail 'FILE exceeds 64 KiB'

trap 'unset value actual expected actual_hash' EXIT
# A sentinel preserves trailing newlines through command substitution.
value="$(cat -- "$file" 2>/dev/null && printf '.')" || fail 'cannot read FILE'
value="${value%.}"
if [ "$encode" -eq 1 ]; then
  value="$(base64 < "$file" 2>/dev/null | tr -d '\r\n')" || fail 'cannot encode FILE'
else
  raw_error='FILE has more than one line or non-printable bytes; keychain would return it as hex. Use --base64.'
  # Bash variables cannot represent NUL bytes. Refuse a lossy raw store.
  bytes="$(printf '%s' "$value" | wc -c)"
  [ "$bytes" -eq "$size" ] || fail "$raw_error"
  value="${value%$'\n'}"
  # Keychain readback hex-encodes values outside a single printable line.
  nonprintable="$(printf '%s' "$value" | LC_ALL=C tr -d ' -~' | wc -c)"
  [ "$nonprintable" -eq 0 ] || fail "$raw_error"
fi
expected="$(printf '%s' "$value" | shasum -a 256)" || fail 'cannot hash value'
exists=0
if security find-generic-password -a "$USER" -s "$name" "$keychain" >/dev/null 2>&1; then
  exists=1
fi
security add-generic-password -U -a "$USER" -s "$name" -w "$value" "$keychain" >/dev/null 2>&1 || fail 'store failed'
actual="$(security find-generic-password -a "$USER" -s "$name" -w "$keychain" 2>/dev/null && printf '.')" || fail 'verification read failed'
actual="${actual%.}"
# security adds one output newline, separate from any stored trailing newlines.
actual="${actual%$'\n'}"
actual_hash="$(printf '%s' "$actual" | shasum -a 256)" || fail 'cannot hash readback'
[ "$expected" = "$actual_hash" ] || fail 'verification failed'
mode=raw
[ "$encode" -eq 0 ] || mode=base64
if [ "$exists" -eq 1 ]; then
  ui_ok "updated: $name (from $file, $mode, $keychain)"
else
  ui_ok "stored: $name (from $file, $mode, $keychain)"
fi
ui_info 'verified'
if [ "$delete_source" -eq 1 ]; then
  rm -- "$file" 2>/dev/null || fail 'verified but could not delete FILE'
fi
