#!/bin/bash
# Rename a secret in the isolated keychain (default: ai.keychain).
# Usage: secret-rename [-f] <OLD> <NEW>
#
# Exposure notes:
#   - The value is read into $value and written straight back out; it is never
#     printed, logged, or passed through a pipe.
#   - argv: security(1) needs -w VALUE as an argument, so the value is briefly
#     visible in `ps` for the duration of the add (~ms) - same caveat as
#     secret-add. A rename is a local move, so there is no clipboard path.
#
# Ordering is add-then-delete on purpose: if the add fails the original is still
# there, and a failed delete leaves a usable copy under both names rather than
# destroying the only copy.
set -euo pipefail

# Load shared UI helpers (follow the install symlink back to the repo).
__self="${BASH_SOURCE[0]}"
while [ -L "$__self" ]; do
  __link="$(readlink "$__self")"
  case "$__link" in
    /*) __self="$__link" ;;
    *)  __self="$(cd -P "$(dirname "$__self")" && pwd)/$__link" ;;
  esac
done
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/ui.sh
. "$(cd -P "$(dirname "$__self")/../lib" && pwd)/ui.sh"

keychain="${SECRET_KEYCHAIN:-ai.keychain}"

usage() {
  cat >&2 <<'EOF'
usage: secret-rename [-f] <OLD> <NEW>   rename a secret, keeping its value
  -f, --force   overwrite NEW if it already exists
The value is moved in-process; it never touches stdout or shell history.
EOF
}

force=0
old=""
new=""
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    -f|--force|--yes) force=1; shift ;;
    --) shift; break ;;
    -*) ui_err "secret-rename: unknown option: $1"; usage; exit 64 ;;
    *)  if [ -z "$old" ]; then old="$1"; elif [ -z "$new" ]; then new="$1"; else
          ui_err "secret-rename: unexpected argument: $1"; usage; exit 64
        fi
        shift ;;
  esac
done
# Positional args after `--`.
if [ -z "$old" ] && [ $# -gt 0 ]; then old="$1"; shift; fi
if [ -z "$new" ] && [ $# -gt 0 ]; then new="$1"; shift; fi

if [ -z "$old" ] || [ -z "$new" ]; then
  usage
  exit 64
fi

if [ "$old" = "$new" ]; then
  ui_err "secret-rename: OLD and NEW are the same name: $old"
  exit 64
fi

if ! security find-generic-password -a "$USER" -s "$old" "$keychain" >/dev/null 2>&1; then
  ui_err "secret-rename: '$old' not found in $keychain"
  exit 1
fi

# Refuse to clobber a different secret by accident - that would destroy a value
# the caller never named. -f is the explicit opt-in.
if security find-generic-password -a "$USER" -s "$new" "$keychain" >/dev/null 2>&1; then
  if [ "$force" -eq 0 ]; then
    ui_err "secret-rename: '$new' already exists in $keychain (use -f to overwrite it)"
    exit 1
  fi
  if [ -t 0 ]; then
    ui_warn "secret-rename: '$new' already exists; its value will be replaced (not archived)."
    ui_confirm "Overwrite $new?" || { ui_info "aborted"; exit 0; }
  fi
fi

# Clear the value from the shell's symbol table on every exit path, including a
# `security` failure under `set -e`. (Does not zero the memory pages; only
# process exit does that.)
trap 'unset value' EXIT

value="$(security find-generic-password -a "$USER" -s "$old" -w "$keychain")"
security add-generic-password -U -a "$USER" -s "$new" -w "$value" "$keychain"
unset value

# The copy exists now, so a delete failure is not data loss - report it and keep
# going rather than leaving the caller thinking nothing happened.
if ! security delete-generic-password -a "$USER" -s "$old" "$keychain" >/dev/null 2>&1; then
  ui_err "secret-rename: copied to '$new' but could not remove '$old' - both names now exist"
  exit 1
fi

ui_ok "renamed: $old -> $new ($keychain)"
